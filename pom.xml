<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.0</version>
    <relativePath/>
  </parent>

  <!-- ⚠️ แก้ artifactId เป็น lab10-{รหัสนักศึกษา}-sec{section} -->
  <groupId>com.example</groupId>
  <artifactId>lab10-673380066-4-sec1</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>lab10-webflux</name>
  <description>Lab 10 — Spring WebFlux + WebClient | CP353002</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>

    <!--
      spring-boot-starter-webflux รวมทุกอย่างไว้:
      - spring-webflux  (WebFlux framework)
      - reactor-core    (Mono, Flux)
      - reactor-netty   (Embedded non-blocking server)
      ⚠️ ห้ามใส่ spring-boot-starter-web ด้วยกัน
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <!-- DevTools — auto-restart เมื่อแก้ไขไฟล์ -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <!-- Test (รวม reactor-test สำหรับทดสอบ Mono/Flux) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
